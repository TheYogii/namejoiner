---
import { Combine, ArrowRight } from '@lucide/astro';
import ToolIcon from '../components/ToolIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolGrid from '../components/ToolGrid.astro';
import { tools, toolBySlug } from '../data/tools';

const title = 'NameJoiner — Free Name Tools for Couples, Babies & Brands';
const description = 'NameJoiner is a free hub of name tools. Blend couple names and baby names, or generate business names, usernames, gamertags and nicknames in seconds. No signup.';
const built = tools.filter((t) => t.built);
const countWord = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'][built.length] ?? String(built.length);
const Count = countWord.charAt(0).toUpperCase() + countWord.slice(1);

const steps = [
  { title: 'Choose a tool', text: 'Choose the one that matches what you are naming: a couple, a baby, a business, a handle, a gamertag or a nickname.' },
  { title: 'Type in your words', text: 'Enter one or two names, or a word or two. Each tool asks only for what it needs, and never for an email address.' },
  { title: 'Copy what you like', text: 'Results appear instantly. Copy any name with one tap, or change an option to re-sort the list.' },
];

const reasons = [
  { title: 'Free, with no signup', text: 'There are no accounts, no paid tier and no daily limit. Open a tool, use it every day if you want, and never hand over an email address.' },
  { title: 'Rules you can read, not AI', text: 'Every result comes from disclosed techniques and our own word lists, such as blending syllables or adding a prefix. Nothing comes from a model, so the same input gives the same list and any name can be explained.' },
  { title: 'Instant, and private', text: 'Everything runs in your browser. Results show up immediately, and the words you type are not sent to a server or stored anywhere.' },
  { title: 'Controls that fit the job', text: 'A nickname needs to know the audience, a gamertag needs a platform, and a baby name needs a middle-name option. Each tool has settings built for its own job, not one algorithm with a new label.' },
  { title: 'Straight about the limits', text: 'A generator cannot promise a name is free or trademark-safe, and platform rules change. Where we work from memory instead of a live check, we say so, and we link out to the places that can confirm.' },
  { title: 'Keep and share your favorites', text: 'Save the results you like and they stay in your browser after a refresh. Share the list with anyone. On mobile it goes to your share sheet, and on desktop you get quick links for WhatsApp, X, Facebook and Email, plus Copy. Whoever receives it needs neither an account nor an app.' },
];

const needs = [
  { need: 'Two names joined for a relationship, a wedding hashtag or a shared account', slug: 'couple-name-combiner' },
  { need: 'A baby name that carries something from both parents', slug: 'baby-name-combiner' },
  { need: 'A name for a startup, a shop or a side project', slug: 'business-name-generator' },
  { need: 'A handle for Instagram, TikTok, Snapchat or X', slug: 'username-generator' },
  { need: 'A name that fits Xbox, PlayStation, Steam, Minecraft or Roblox', slug: 'gamertag-generator' },
  { need: 'A friendly, funny or affectionate name for someone you know', slug: 'nickname-generator' },
].map((r) => ({ ...r, tool: toolBySlug(r.slug) })).filter((r) => r.tool.built);

const faqs = [
  {
    q: 'Is NameJoiner free?',
    a: 'Yes. Every tool is free to use as often as you like, and there is no paid tier hiding behind them. We may one day cover running costs with ads or clearly labeled affiliate links. Neither is live today, and neither would ever make anything cost you more.',
  },
  {
    q: 'Do I need to sign up?',
    a: 'No. NameJoiner has no accounts, so there is no email to give and no password to forget. The catch is that we cannot save your results for you, so copy the names you like before you close the page.',
  },
  {
    q: 'Does NameJoiner use AI?',
    a: 'No. The tools follow fixed rules and hand-picked word lists that we wrote and can explain. That makes the results repeatable, but a rule cannot judge taste, so say your favorites out loud before you commit to one.',
  },
  {
    q: 'How many tools does NameJoiner have?',
    a: `${Count} at the moment: ${built.map((t) => t.name).join(', ')}. Each has its own options instead of one generic box. If there is a name tool you wish existed, the contact page is the place to suggest it.`,
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'NameJoiner',
    url: 'https://namejoiner.com/',
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<BaseLayout {title} {description} path="/" {schema}>
  <section class="mx-auto max-w-6xl px-4 pb-12 pt-16 sm:px-6 sm:pt-24">
    <p class="text-sm font-medium text-accent-dark">Free name tools</p>
    <h1 class="mt-3">Blend names into something new</h1>
    <p class="mt-5 text-base leading-[1.55] text-ink-soft sm:text-lg sm:leading-8">
      NameJoiner is a small collection of free tools that mix two names, or a handful of words, into fresh options you can copy and use.
    </p>
    <div class="mt-8">
      <a href="/couple-name-combiner" class="btn-primary inline-flex items-center rounded-full font-medium"><Combine size={18} strokeWidth={1.75} aria-hidden="true" />Try the couple name combiner</a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-8 sm:px-6" aria-labelledby="tools-heading">
    <h2 id="tools-heading" class="mb-6">Pick a tool</h2>
    <ToolGrid />
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-8 pt-12 sm:px-6" aria-labelledby="how-heading">
    <h2 id="how-heading" class="mb-6 text-center">How it works</h2>
    <!-- Connected timeline: numbered badges on a line, each with centered text beneath. Vertical below md, horizontal from md up. Styles: .tl-* in global.css. -->
    <ol class="timeline grid gap-x-6 md:grid-cols-3" data-timeline>
      {steps.map((st, i) => (
        <li class="tl-step relative pb-10 text-center last:pb-0 md:pb-0" style={`--i:${i}`}>
          <span class="tl-node relative z-10 mx-auto flex size-12 items-center justify-center rounded-full bg-accent-dark text-lg font-semibold text-white" aria-hidden="true">{i + 1}</span>
          {i < steps.length - 1 && <span class="tl-line absolute bg-accent/40" aria-hidden="true"></span>}
          <div class="tl-body mx-auto mt-4 max-w-xs">
            <h3 class="text-lg">{st.title}</h3>
            <p class="mt-2 text-base leading-[1.55] text-ink-soft sm:leading-7">{st.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-8 pt-12 sm:px-6" aria-labelledby="why-heading">
    <h2 id="why-heading" class="mb-6">What makes NameJoiner different</h2>
    <ul class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
      {reasons.map((r) => (
        <li>
          <h3 class="text-lg">{r.title}</h3>
          <p class="mt-1 text-base leading-[1.55] text-ink-soft sm:leading-7">{r.text}</p>
        </li>
      ))}
    </ul>
    <p class="mt-8 rounded-[16px] border border-line bg-white p-5 text-base leading-[1.55] text-ink-soft sm:leading-7">
      <strong class="text-ink">How this compares with other name tools.</strong> Some generators say “AI” without explaining what it does, some ask for an account before you can save or share, and some put the tool behind popups. NameJoiner takes the plainer route: the rules are disclosed, every feature works without an account, and the tool is the first thing on the page.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-8 pt-12 sm:px-6" aria-labelledby="which-heading">
    <h2 id="which-heading" class="mb-2">Which tool do you need?</h2>
    <p class="mb-6 text-base leading-[1.55] text-ink-soft sm:leading-7">Not sure where to start? Find what you are naming and follow the link.</p>
    <ul class="space-y-3">
      {needs.map((r) => (
        <li data-theme={r.tool.theme} class="card group relative flex flex-col gap-4 p-5 transition-colors hover:border-accent sm:flex-row sm:items-center sm:justify-between sm:gap-6">
          <p class="text-base leading-[1.55] text-ink-soft sm:leading-7">{r.need}</p>
          <a
            href={`/${r.slug}`}
            class="inline-flex min-h-11 shrink-0 items-center gap-2 self-start whitespace-nowrap rounded-full bg-pill-a px-4 text-sm font-semibold text-accent-dark transition-colors after:absolute after:inset-0 after:rounded-[16px] group-hover:bg-accent-dark group-hover:text-white sm:self-auto"
          >
            <ToolIcon icon={r.tool.icon} size={16} />
            {r.tool.name}
            <ArrowRight size={16} strokeWidth={1.75} aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-8 pt-12 sm:px-6" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="mb-6">Common questions</h2>
    <div class="space-y-6">
      {faqs.map((f) => (
        <div>
          <h3 class="text-lg">{f.q}</h3>
          <p class="mt-1 text-base leading-[1.55] text-ink-soft sm:leading-7">{f.a}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  // Draw the timeline in once it scrolls into view. Skipped for reduced motion or browsers without IntersectionObserver,
  // in which case the timeline is simply shown, so content is never hidden.
  const timeline = document.querySelector<HTMLElement>('[data-timeline]');
  if (timeline && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    timeline.setAttribute('data-armed', '');
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        timeline.setAttribute('data-in', '');
        io.disconnect();
      }
    }, { threshold: 0.3 });
    io.observe(timeline);
  }
</script>
