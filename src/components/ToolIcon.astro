---
import { Heart, Baby, Briefcase, AtSign, Smile, Gamepad2 } from '@lucide/astro';
import type { Tool } from '../data/tools';
interface Props { icon: Tool['icon']; size?: number; class?: string }
const { icon, size = 22, class: cls } = Astro.props;
const map = { heart: Heart, baby: Baby, briefcase: Briefcase, 'at-sign': AtSign, smile: Smile, gamepad: Gamepad2 };
const Icon = map[icon];
---
<Icon size={size} strokeWidth={1.75} class={cls} aria-hidden="true" />
