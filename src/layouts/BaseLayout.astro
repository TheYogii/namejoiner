---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { ThemeName } from '../data/tools';

interface Props {
  title: string;
  description: string;
  /** Path such as "/couple-name-combiner"; resolved against the site URL. */
  path?: string;
  theme?: ThemeName;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  /** One or more JSON-LD objects. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title, description, path = Astro.url.pathname, theme, noindex = false,
  ogImage = '/og-default.png',
  ogImageAlt = 'NameJoiner: free name combiner tools',
  schema,
} = Astro.props;
const site = 'https://namejoiner.com';
const canonical = new URL(path === '/' ? '/' : path.replace(/\/$/, ''), site).href;
const image = new URL(ogImage, site).href;
const ORG_ID = `${site}/#organization`;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': ORG_ID,
  name: 'NameJoiner',
  url: `${site}/`,
  logo: { '@type': 'ImageObject', url: `${site}/android-chrome-512x512.png`, width: 512, height: 512 },
};
// WebSite and WebApplication entities name the Organization as their publisher, so the brand is one connected entity across the site.
const withPublisher = (s: Record<string, unknown>) =>
  s['@type'] === 'WebSite' || s['@type'] === 'WebApplication' ? { ...s, publisher: { '@id': ORG_ID } } : s;
const schemas = [organization, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []).map(withPublisher)];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#FFFBF9" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NameJoiner" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body data-theme={theme}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:shadow">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
