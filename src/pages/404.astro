---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolGrid from '../components/ToolGrid.astro';
---
<BaseLayout title="Page Not Found — NameJoiner" description="That page doesn't exist on NameJoiner. Head back to the homepage and pick one of our free name combiner tools." path="/404" noindex>
  <section class="mx-auto max-w-6xl px-4 pb-8 pt-16 sm:px-6 sm:pt-24">
    <p class="text-sm font-medium text-accent-dark">Error 404</p>
    <h1 class="mt-3 max-w-2xl">This name didn't combine into a page</h1>
    <p class="mt-5 max-w-xl text-base leading-[1.55] text-ink-soft sm:text-lg sm:leading-8">The link may be old or mistyped. Try one of the tools below, or <a class="link" href="/">go back to the homepage</a>.</p>
  </section>
  <section class="mx-auto max-w-6xl px-4 sm:px-6" aria-labelledby="t404"><h2 id="t404" class="mb-6">Our tools</h2><ToolGrid /></section>
</BaseLayout>
